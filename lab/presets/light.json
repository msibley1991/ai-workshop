{
  "resolution": {
    "pixelScale": 1,
    "hardText": 0.56
  },
  "glow": {
    "intensity": 1,
    "radius": 1,
    "tintToPhosphor": 0
  },
  "ghost": {
    "decay": 0.75,
    "scrollGain": 0,
    "blur": 1.5
  },
  "grid": {
    "mode": "scanlines",
    "opacity": 0.22,
    "pitch": 2,
    "snapScroll": true
  },
  "phosphor": {
    "persistenceColor": "#ff0088",
    "persistenceColor2": "#00c7f7",
    "persistenceColor3": "#8A1A00",
    "layers": 2,
    "layerMode": "blend",
    "layerFrames": 10,
    "shift": 1,
    "jitter": 1,
    "flicker": 0.05
  },
  "theme": {
    "mode": "light",
    "light": {
      "ground": "#f4f4eb",
      "phosphor": "#00010f",
      "accent": "#F38020"
    },
    "dark": {
      "ground": "#0A0C10",
      "phosphor": "#3D7BFF",
      "accent": "#F38020"
    }
  },
  "outline": {
    "width": 2
  },
  "type": {
    "family": "JetBrains Mono",
    "h1": {
      "size": 72,
      "lineHeight": 1.05
    },
    "h2": {
      "size": 44,
      "lineHeight": 1.15
    },
    "h3": {
      "size": 32,
      "lineHeight": 1.25
    },
    "body": {
      "size": 28,
      "lineHeight": 1.45
    },
    "small": {
      "size": 20,
      "lineHeight": 1.4
    },
    "gap": 32
  },
  "object": {
    "style": "edges + faces",
    "spin": 0.3
  }
}
